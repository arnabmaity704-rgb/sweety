# Port the API listens on
PORT=5000

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweety

# Secret used to sign login tokens. Use a long random string in real deployments.
JWT_SECRET=replace-with-a-long-random-string

# How long a login stays valid (e.g. 1h, 7d)
JWT_EXPIRES_IN=7d

# Origin of the React app, allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional: timezone used for "today" (future-date check). Defaults to the machine's timezone.
# TZ=Asia/Kolkata

{
  "name": "sweety-server",
  "version": "1.0.0",
  "private": true,
  "description": "Sweety – Blood Glucose Tracker API (Express + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.2"
  }
}
